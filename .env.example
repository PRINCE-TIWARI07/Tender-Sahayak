NODE_ENV=development

# AI eligibility extraction (required for structured criteria from tender text)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
MAX_ANALYSIS_CHARACTERS=100000

OCR_LANG=eng

# Listen address: use 127.0.0.1 locally; use 0.0.0.0 in Docker / cloud VMs
HOST=127.0.0.1
PORT=3000

# Behind nginx/Caddy/load balancer — set when you terminate TLS upstream
# TRUST_PROXY=1
