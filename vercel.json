{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" },
    { "src": "src/server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(audit-report|pipeline|upload|evaluate|health)(/.*)?", "dest": "/src/server.js" },
    { "src": "\/", "dest": "/dist/index.html" },
    { "handle": "filesystem" },
    { "src": "\/(.*)", "dest": "/dist/$1" }
  ]
}
